{
  "name": "magpie",
  "short_name": "magpie",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f4f4f6",
  "theme_color": "#f4f4f6",
  "icons": [
    {
      "src": "icons/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ],
  "id": "com.dsh.mobile.extension.magpie",
  "version": "1.0.1",
  "apiVersion": "1",
  "main": "index.html",
  "description": "在手机上打开 magpie 的完整界面（Agents / Providers / Routing / Usage / Settings）。按需下载，数据经宿主取。",
  "capabilities": [
    "content.read",
    "card.write",
    "host.data"
  ],
  "hostData": {
    "service": "magpie",
    "match": [
      "/api/"
    ]
  }
}
