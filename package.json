{
  "name": "dsh-mobile-plugin",
  "version": "0.5.48",
  "description": "Mobile API (/api/mobile/v1) and relay client for the DSH mobile app — desktop profile build (dsh 0.2.x, peers resolved by the host)",
  "license": "MIT",
  "icon": "./icon.png",
  "engines": {
    "dsh": ">=0.2.0"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-mobile-plugin": "host.js",
    "dsh-mobile-plugin-pair": "lib/cli/pair.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WNLUO/dsh-mobile-plugin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis-plugin",
    "plugin",
    "mobile",
    "remote-control",
    "headless",
    "relay",
    "tunnel",
    "lan",
    "android",
    "ios"
  ],
  "files": [
    "host.js",
    "cordis.patch.yml",
    "cordis.mobile-host.yml",
    "config/**/*.yml",
    "lib/**/*.js",
    "lib/**/*.cjs",
    "lib/**/*.html",
    "lib/**/package.json",
    "dsh-mobile-credentials",
    "locale/*.json",
    "icon.png",
    "skills/**",
    "extensions/**",
    "docs/extension-authoring.md",
    "docs/extension-sample/**",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node host.js",
    "test": "node --test test/*.test.cjs && node test/lan-direct-e2e.cjs && node test/sidecar-facade.cjs",
    "sync:author-docs": "node scripts/sync-author-docs.mjs",
    "check:author-docs": "node scripts/sync-author-docs.mjs --check",
    "release:check": "node scripts/preflight-release.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  },
  "optionalDependencies": {
    "dsh-mobile-tailcat-darwin-arm64": "1.1.1",
    "dsh-mobile-tailcat-darwin-x64": "1.1.1",
    "dsh-mobile-tailcat-linux-arm64": "1.1.1",
    "dsh-mobile-tailcat-linux-x64": "1.1.1",
    "dsh-mobile-tailcat-win32-x64": "1.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-directory-picker-browse": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-present": "^0.2.1-rc.3 || ^0.2.2-rc.1",
    "yaml": "2.9.1"
  }
}
