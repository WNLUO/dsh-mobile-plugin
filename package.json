{
  "name": "dsh-mobile-plugin",
  "version": "0.1.81",
  "description": "Mobile API (/api/mobile/v1) and relay client for the DSH mobile app — desktop profile build (0.2.0-rc.2 compatible, peers resolved by the host)",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-mobile-plugin": "host.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WNLUO/dsh-mobile-plugin.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "mobile",
    "relay"
  ],
  "files": [
    "host.js",
    "cordis.patch.yml",
    "cordis.mobile-host.yml",
    "config/**/*.yml",
    "lib/**/*.js",
    "lib/**/*.cjs",
    "lib/**/*.html",
    "lib/**/package.json",
    "dsh-mobile-credentials",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node host.js",
    "test": "node --test test/*.test.cjs && node test/lan-direct-e2e.cjs && node test/sidecar-facade.cjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tool-ask-user": "0.1.1-rc.2",
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-settings": ">=0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-directory-picker-browse": "0.1.1-rc.2",
    "yaml": "2.9.1"
  }
}
