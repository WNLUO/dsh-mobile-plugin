{
  "name": "dsh-mobile-plugin",
  "version": "0.5.134",
  "description": "Mobile API (/api/mobile/v1) and relay client for the DSH mobile app — desktop profile build (dsh 0.2.x, peers resolved by the host)",
  "license": "MIT",
  "icon": "./icon.png",
  "engines": {
    "dsh": ">=0.2.0-0"
  },
  "type": "module",
  "main": "lib/index.js",
  "bin": {
    "dsh-mobile-plugin": "host.js",
    "dsh-mobile-plugin-pair": "lib/cli/pair.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WNLUO/dsh-mobile-plugin.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek-harness-plugin",
    "cordis-plugin",
    "plugin",
    "mobile",
    "remote-control",
    "headless",
    "relay",
    "tunnel",
    "lan",
    "android",
    "ios"
  ],
  "files": [
    "host.js",
    "cordis.patch.yml",
    "cordis.mobile-host.yml",
    "config/**/*.yml",
    "config/**/skills/**",
    "lib/**/*.js",
    "lib/**/*.cjs",
    "lib/**/*.html",
    "lib/**/package.json",
    "native/**",
    "dsh-mobile-credentials",
    "locale/*.json",
    "icon.png",
    "skills/**",
    "extensions/**",
    "extension-registry/index.json",
    "docs/extension-authoring.md",
    "docs/chat-embed.md",
    "docs/extension-sample/**",
    "README.md"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "start": "node host.js",
    "test": "node --test test/*.test.cjs && node test/lan-direct-e2e.cjs && node test/sidecar-facade.cjs",
    "sync:author-docs": "node scripts/sync-author-docs.mjs",
    "check:author-docs": "node scripts/sync-author-docs.mjs --check",
    "release:check": "node scripts/preflight-release.mjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.4",
    "qrcode": "1.5.4",
    "ws": "8.23.0"
  },
  "optionalDependencies": {
    "dsh-mobile-shell-darwin-arm64": "0.1.3",
    "dsh-mobile-shell-darwin-x64": "0.1.3",
    "dsh-mobile-shell-linux-arm64": "0.1.3",
    "dsh-mobile-shell-linux-x64": "0.1.3",
    "dsh-mobile-shell-win32-x64": "0.1.3",
    "dsh-mobile-tailcat-darwin-arm64": "1.1.7",
    "dsh-mobile-tailcat-darwin-x64": "1.1.7",
    "dsh-mobile-tailcat-linux-arm64": "1.1.7",
    "dsh-mobile-tailcat-linux-x64": "1.1.7",
    "dsh-mobile-tailcat-win32-x64": "1.1.7",
    "dsh-mobile-tailcat-win32-arm64": "1.1.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 || >=4.0.1-rc.1 <4.0.2-0 || >=4.0.5-alpha.1 <4.0.6-0 || >=4.0.6-alpha.1 <4.0.7-0 || >=4.2.0-alpha.1 <4.2.1-0",
    "@deepseek-ai/dsh-client-locale": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.2 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/schemastery": ">=3.18.1 || >=3.18.1-rc.1 <3.18.2-0 || >=3.18.5-alpha.1 <3.18.6-0 || >=3.18.6-alpha.1 <3.18.7-0 || >=3.20.0-alpha.1 <3.20.1-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-host-directory-picker-browse": "^0.2.1-rc.3 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-tool-ask-user": "^0.2.1-rc.3 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "@deepseek-ai/dsh-tool-present": "^0.2.1-rc.3 || ^0.2.2-rc.1 || ^0.2.3-alpha.1",
    "yaml": "2.9.1"
  },
  "dshMobileReleaseNotes": {
    "version": "0.5.134",
    "kinds": [
      "fix"
    ],
    "notes": {
      "zh-Hans": "- 使用 DSH 预发布版时，插件安装和更新不再因依赖范围过窄而报冲突。",
      "zh-Hant": "- 使用 DSH 預發布版時，外掛安裝與更新不再因相依範圍過窄而回報衝突。",
      "en": "- Installing or updating the plugin on prerelease builds of DSH no longer fails on a dependency range conflict.",
      "ja": "- DSH のプレリリース版でも、依存範囲が狭すぎることでプラグインのインストールや更新が失敗しなくなりました。",
      "ko": "- DSH 사전 릴리스 버전에서 의존성 범위가 좁아 플러그인 설치·업데이트가 실패하던 문제를 해결했습니다.",
      "de": "- Unter Vorabversionen von DSH lassen sich Installation und Update des Plugins nicht mehr durch einen zu engen Abhängigkeitsbereich blockieren.",
      "es": "- En las versiones preliminares de DSH, instalar o actualizar el plugin ya no falla por un rango de dependencias demasiado estrecho.",
      "fr": "- Sur les versions préliminaires de DSH, l'installation et la mise à jour du plugin ne sont plus bloquées par une plage de dépendances trop restrictive.",
      "pt": "- Em versões de pré-lançamento do DSH, instalar ou atualizar o plugin não falha mais por um intervalo de dependências restrito demais.",
      "ru": "- В предварительных сборках DSH установка и обновление плагина больше не завершаются ошибкой из-за слишком узкого диапазона зависимостей.",
      "tr": "- DSH'nin yayın öncesi sürümlerinde, çok dar bir bağımlılık aralığı nedeniyle eklentinin kurulumu ve güncellenmesi artık başarısız olmuyor."
    }
  }
}
